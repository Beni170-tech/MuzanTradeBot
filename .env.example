# Sprint 8B - Maximum Open Portfolio Positions (Paper Trading Only)
#
# When PORTFOLIO_MAX_OPEN_POSITIONS is set above 0, /analyze rejects any
# new paper trade that would open when the paper account already has that
# many open positions across all symbols combined.
#
# Rules:
#   - Portfolio-wide, not per-symbol.
#   - Rejects new trades when current_open_positions >= limit.
#   - Disabled by default (0).
#   - Gate placement: after Daily Loss circuit breaker, before Symbol
#     Concentration check.
#   - /stats section shown only when the limit is configured.
#
PORTFOLIO_MAX_OPEN_POSITIONS=0
