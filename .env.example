[TEMPLATE]
# ==============================================
# MuzanTradeBot - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Binance API Credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit API Credentials
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Kraken API Credentials
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Bot Modes (true/false)
GUARDIAN_MODE=true
PAPER_TRADING=true

# Risk Profile (Guardian Mode parameters)
# ACCOUNT_BALANCE is the capital available for trading.
# RISK_PERCENT is the percentage of the account risked per trade
# (a stop-out loses exactly this amount).
# STOP_LOSS_PERCENT and TAKE_PROFIT_PERCENT are distances from entry.
ACCOUNT_BALANCE=1000
RISK_PERCENT=2
STOP_LOSS_PERCENT=2
TAKE_PROFIT_PERCENT=4

# Portfolio Risk Limit (Sprint 7A)
# Maximum total dollar risk across all open paper positions. A trade
# that would push total risk above this limit is rejected.
# 0 disables the limit (backward compatible).
PORTFOLIO_RISK_LIMIT=0

# Portfolio Exposure Limit (Sprint 7B)
# Maximum total notional exposure (entry_price * quantity) across all
# open paper positions. A trade that would push total exposure above
# this limit is rejected.
# 0 disables the limit (backward compatible).
PORTFOLIO_EXPOSURE_LIMIT=0

# Correlation Risk Manager (Sprint 7C)
# Maximum number of open paper positions allowed on a single symbol.
# A trade on a symbol that already has this many open positions is
# rejected. 0 disables the per-symbol position-count rule.
PORTFOLIO_MAX_POSITIONS_PER_SYMBOL=0

# Maximum total notional exposure (entry_price * quantity) allowed on
# a single symbol across all open paper positions. A trade that would
# push a symbol's exposure above this limit is rejected.
# 0 disables the per-symbol exposure rule (backward compatible).
PORTFOLIO_MAX_EXPOSURE_PER_SYMBOL=0

# Daily Loss Circuit Breaker (Sprint 8A)
# Maximum net realized loss allowed per local calendar day across all
# paper positions. When the day's realized PnL reaches -LIMIT, new
# paper trades are halted until the next day. Existing positions are
# still managed and closable (SL/TP, trailing, /close).
# 0 disables the brake (backward compatible).
PORTFOLIO_DAILY_LOSS_LIMIT=0
