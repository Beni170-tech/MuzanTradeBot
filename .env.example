# Sprint 8B - Maximum Open Portfolio Positions (Paper Trading Only)
#
# When PORTFOLIO_MAX_OPEN_POSITIONS is set above 0, /analyze rejects any
# new paper trade that would open when the paper account already has that
# many open positions across all symbols combined.
#
# Rules:
#   - Portfolio-wide, not per-symbol.
#   - Rejects new trades when current_open_positions >= limit.
#   - Disabled by default (0).
#   - Gate placement: after Daily Loss circuit breaker, before Symbol
#     Concentration check.
#   - /stats section shown only when the limit is configured.
#
PORTFOLIO_MAX_OPEN_POSITIONS=0

# ---------------------------------------------------------------------------
# Sprint 9A - Telegram Alerts & Notifications
# ---------------------------------------------------------------------------
#
# When ALERTS_ENABLED is true, MuzanTradeBot pushes a Telegram alert for
# each of the following events:
#
#   - Paper order placed
#   - Stop-loss triggered
#   - Take-profit triggered
#   - Trailing stop update (stop moved after 1R profit)
#   - Guardian/risk-limit trade rejection (portfolio risk, exposure,
#     daily loss, max open positions, symbol concentration)
#   - Daily loss breaker activation
#   - Maximum open positions reached
#
# Rules:
#   - Alerts are sent to the chat id in TELEGRAM_ALERT_CHAT_ID.
#   - The same bot token is reused (TELEGRAM_BOT_TOKEN).
#   - Alert failures are logged and never break the trading flow.
#   - Disabled by default (false). When TELEGRAM_ALERT_CHAT_ID is empty,
#     alerts stay disabled even if ALERTS_ENABLED is true.
#   - To find your chat id, message @userinfobot on Telegram.
#
ALERTS_ENABLED=false
TELEGRAM_ALERT_CHAT_ID=
