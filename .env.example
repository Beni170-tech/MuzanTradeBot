# ==============================================
# MuzanTradeBot - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Binance API Credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit API Credentials
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Kraken API Credentials
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Bot Modes (true/false)
GUARDIAN_MODE=true
PAPER_TRADING=true
