# ---------------------------------------------------------------------------
# MuzanTradeBot - environment reference
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in what you need. .env is git-ignored;
# never commit real credentials. Every execution path is paper trading.
#
# Required:
#   TELEGRAM_BOT_TOKEN - token from @BotFather.
#   TELEGRAM_ALLOWED_CHAT_IDS - authorized ids; empty locks the bot
#     (see the Milestone M-A block below).
#
# Execution mode: PAPER is the only valid value. Startup refuses to run
# with an unrecognized mode or with PAPER_TRADING=true and a non-PAPER
# mode.
EXECUTION_MODE=PAPER
PAPER_TRADING=true

TELEGRAM_BOT_TOKEN=

GUARDIAN_MODE=true

# Starting balance for a new paper account. Position sizing risks
# RISK_PERCENT of current paper equity, not of this value.
#
# These four risk inputs are parsed strictly. Blank or missing keeps the
# default shown here; a malformed or non-finite value (10O0, 2%, nan)
# is a configuration error that names the variable and blocks startup.
# ACCOUNT_BALANCE also anchors the Guardian portfolio limit defaults, so
# it must be a plain number.
ACCOUNT_BALANCE=1000
RISK_PERCENT=2.0
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=4.0

# Background paper position monitor: seconds between cycles.
# <= 0 disables the monitor (and new entries then require fresh marks).
PAPER_MONITOR_INTERVAL_SECONDS=45

# Per-chat Telegram command rate limiting. <= 0 disables it.
TELEGRAM_COMMAND_RATE_LIMIT_PER_WINDOW=12
TELEGRAM_COMMAND_RATE_WINDOW_SECONDS=10

# ---------------------------------------------------------------------------
# Guardian portfolio limits (enabled by default)
# ---------------------------------------------------------------------------
# Unset or blank  -> conservative default, derived from ACCOUNT_BALANCE.
# Explicit 0      -> that gate is disabled.
# Negative, NaN   -> configuration error; startup refuses to run.
# Non-numeric     -> configuration error naming the variable.
#
# PORTFOLIO_RISK_LIMIT             - max total $ risk across open positions
# PORTFOLIO_EXPOSURE_LIMIT         - max total notional exposure
# PORTFOLIO_DAILY_LOSS_LIMIT       - max day loss: settled PnL for the
#                                    calendar day plus floating PnL on
#                                    open positions at their marks
# PORTFOLIO_MAX_OPEN_POSITIONS     - max open positions across all symbols
# PORTFOLIO_MAX_POSITIONS_PER_SYMBOL - max open positions on one symbol
# PORTFOLIO_MAX_EXPOSURE_PER_SYMBOL  - max notional exposure per symbol
#
# Entry gates run in this order: portfolio risk -> exposure -> daily
# loss -> max open positions -> per-symbol count -> per-symbol exposure.
#
# Defaults with ACCOUNT_BALANCE=1000:
#   PORTFOLIO_RISK_LIMIT=60               (6%)
#   PORTFOLIO_EXPOSURE_LIMIT=3000         (300%)
#   PORTFOLIO_DAILY_LOSS_LIMIT=30         (3%)
#   PORTFOLIO_MAX_OPEN_POSITIONS=3
#   PORTFOLIO_MAX_POSITIONS_PER_SYMBOL=1
#   PORTFOLIO_MAX_EXPOSURE_PER_SYMBOL=2000 (200%)
#
# The daily loss limit counts settled PnL plus floating PnL at recorded
# marks. An open position with no usable mark is never counted as zero:
# new entries are blocked until every open position can be priced.
#
# Leave these commented out to use the defaults, or set a value to
# override it. Setting 0 explicitly disables that protection.
# PORTFOLIO_RISK_LIMIT=60
# PORTFOLIO_EXPOSURE_LIMIT=3000
# PORTFOLIO_DAILY_LOSS_LIMIT=30
# PORTFOLIO_MAX_OPEN_POSITIONS=3
# PORTFOLIO_MAX_POSITIONS_PER_SYMBOL=1
# PORTFOLIO_MAX_EXPOSURE_PER_SYMBOL=2000

# Sprint 8B - Maximum Open Portfolio Positions (Paper Trading Only)
#
# When PORTFOLIO_MAX_OPEN_POSITIONS is set above 0, /analyze rejects any
# new paper trade that would open when the paper account already has that
# many open positions across all symbols combined.
#
# Rules:
#   - Portfolio-wide, not per-symbol.
#   - Rejects new trades when current_open_positions >= limit.
#   - Default 3; set 0 to disable explicitly.
#   - Gate placement: after Daily Loss circuit breaker, before Symbol
#     Concentration check.
#   - /stats section shown only when the limit is configured.
#
# PORTFOLIO_MAX_OPEN_POSITIONS=3

# ---------------------------------------------------------------------------
# Sprint 9A - Telegram Alerts & Notifications
# ---------------------------------------------------------------------------
#
# When ALERTS_ENABLED is true, MuzanTradeBot pushes a Telegram alert for
# each of the following events:
#
#   - Paper order placed
#   - Stop-loss triggered
#   - Take-profit triggered
#   - Trailing stop update (stop moved after 1R profit)
#   - Guardian/risk-limit trade rejection (portfolio risk, exposure,
#     daily loss, max open positions, symbol concentration)
#   - Daily loss breaker activation
#   - Maximum open positions reached
#
# Rules:
#   - Alerts are sent to the chat id in TELEGRAM_ALERT_CHAT_ID.
#   - The same bot token is reused (TELEGRAM_BOT_TOKEN).
#   - Alert failures are logged and never break the trading flow.
#   - Disabled by default (false). When TELEGRAM_ALERT_CHAT_ID is empty,
#     alerts stay disabled even if ALERTS_ENABLED is true.
#   - To find your chat id, message @userinfobot on Telegram.
#
ALERTS_ENABLED=false
TELEGRAM_ALERT_CHAT_ID=

# ---------------------------------------------------------------------------
# Milestone M-A - Telegram Access Control
# ---------------------------------------------------------------------------
#
# Comma-separated Telegram user ids and/or chat ids allowed to use the
# bot. Matching either the sender's user id or the chat id authorizes an
# update, so a private chat can be listed by user id and a group by its
# (negative) chat id.
#
# Rules:
#   - Empty or missing means NOBODY is authorized. This is deliberate:
#     access is denied by default and no command runs for an
#     unauthorized update.
#   - Invalid entries are ignored; entries that all parse to nothing
#     leave the bot locked.
#   - The bot replies with a denial notice and sends no account data.
#   - Use @userinfobot to find your Telegram user id.
#
# Example: TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890
#
TELEGRAM_ALLOWED_CHAT_IDS=
